# Copy this file to `configs/mayuri_v2.env`, edit the placeholder paths,
# then source it before running commands.

export GPT_SOVITS_ROOT="/path/to/GPT-SoVITS"
export GPT_SOVITS_MODEL_ROOT="/path/to/GPT-SoVITS-models"

export MAYURI_AMADEUS_ROOT="/path/to/Mayuri-Amadeus"
export MAYURI_AUDIO_DIR="$MAYURI_AMADEUS_ROOT/data/raw/wav"
export MAYURI_ASR_CSV="$MAYURI_AMADEUS_ROOT/data/meta/mayuri_asr_raw.csv"
export MAYURI_MANIFEST="$MAYURI_AMADEUS_ROOT/data/manifests/mayuri_ja_filtered.list"

export MAYURI_EXP_NAME="mayuri_v2"
export MAYURI_VERSION="v2"
export MAYURI_GPUS="0"

export MAYURI_SOVITS_BATCH_SIZE="4"
export MAYURI_SOVITS_EPOCHS="16"
export MAYURI_GPT_BATCH_SIZE="2"
export MAYURI_GPT_EPOCHS="12"
